{
  "name": "choflix-prompter",
  "version": "3.3.0",
  "description": "CHOFLIX PROMPTER — 방송용 프롬프터",
  "author": "CHOFLIX AI Lab",
  "license": "MIT",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "node scripts/pack-win.mjs",
    "build:setup": "node scripts/pack-win.mjs && node scripts/pack-setup.mjs",
    "build:win:packager": "electron-packager . ChoflixPrompter --platform=win32 --arch=x64 --icon=build/app.ico --out=dist --overwrite --asar",
    "install:buildonly": "npm install --ignore-scripts",
    "build:docs": "node docs-src/build-docs.mjs",
    "fetch:model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2",
    "pdf-lib": "^1.17.1",
    "resedit": "^3.0.2",
    "sherpa-onnx-node": "^1.13.8"
  }
}
